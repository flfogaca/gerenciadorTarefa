# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (Supabase)
DATABASE_URL="postgresql://postgres:eS7tM9qVzCypndSh@db.xsjstlmbiglwlqugiyxl.supabase.co:5432/postgres?schema=public"

# JWT Configuration
JWT_SECRET=gestorpro_jwt_secret_key_2024_development_only_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=gestorpro_refresh_secret_key_2024_development_only_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=noreply@gestorpro.com

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Redis Configuration (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# Multi-tenant Configuration
TENANT_DATABASE_PREFIX=tenant_
TENANT_SCHEMA_PREFIX=tenant_

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=gestorpro_session_secret_2024_development_only_change_in_production

# External Services
GOOGLE_CLIENT_ID=seu-google-client-id
GOOGLE_CLIENT_SECRET=seu-google-client-secret

# Monitoring
SENTRY_DSN=sua-sentry-dsn-aqui

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_TWO_FACTOR_AUTH=false
